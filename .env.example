# Google OAuth 2.0 Credentials
# 1. Go to https://console.cloud.google.com/
# 2. Select / Create a project and Enable "Google Drive API"
# 3. Under "OAuth consent screen", set User Type to External, add scope ".../auth/drive.file"
# 4. Under "Credentials", create:
#    - Web Application Client ID (use this for EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB)
#    - Android Client ID with package "com.aryan_tomar.SmartKissan" (for EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
#or
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=
